# Use a unique Compose project name for each isolated run.
COMPOSE_PROJECT_NAME=probench-demo
BENCH_RUN_NAME=openclaw-demo
BENCH_TASK_NAME=travel_beijing_realistic
BENCH_TASKS_HOST_DIR=./examples
BENCH_SERVICE_MODULES=
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_GATEWAY_TOKEN=replace-with-random-token
AGENT_API_BASE_URL=https://your-agent-provider.example/v1
AGENT_API_KEY=replace-with-agent-key
AGENT_MODEL=replace-with-agent-model
AGENT_TEMPERATURE=0
AGENT_CONTEXT_WINDOW=128000
BENCH_JUDGE_BASE_URL=https://your-judge-provider.example/v1
BENCH_JUDGE_API_KEY=replace-with-judge-key
BENCH_JUDGE_MODEL=replace-with-judge-model
